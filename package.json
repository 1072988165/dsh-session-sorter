{
  "name": "dsh-session-sorter",
  "version": "0.1.0",
  "description": "会话排序插件：按创建时间或标题重排工作区会话，修复导入会话后侧栏时间线错乱 · DSH session sorter",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "session",
    "sort",
    "reorder"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1072988165/dsh-session-sorter.git"
  },
  "homepage": "https://github.com/1072988165/dsh-session-sorter#readme",
  "bugs": {
    "url": "https://github.com/1072988165/dsh-session-sorter/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
